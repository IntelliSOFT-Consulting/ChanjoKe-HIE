SSL_CERT_PATH=./certs/star.intellisoftkenya.com.crt
SSL_KEY_PATH=./certs/star.intellisoftkenya.com.key

# Database Configuration
# =====================

# HAPI FHIR Database
HAPI_DB_USER=postgres
