KEYCLOAK_CLIENT_ID=openhim-oauth

# ChanjoKe Auth Service
CHANJOKE_AUTH_JWT_SECRET=your-jwt-secret-key-here
CHANJOKE_AUTH_DB_URL=postgresql://postgres:hapi123@hapi-fhir-postgres:5432/hapi

# Web Applications
VITE_SERVER_BASE_URL=https://chanjo-provider.yourdomain.com/auth
VITE_SUPERSET_DOMAIN=https://chanjo-reports.yourdomain.com
