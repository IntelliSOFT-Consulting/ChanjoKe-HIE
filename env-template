# Data Pipes/Reports Domain
DATA_PIPES_DOMAIN=chanjo-reports.intellisoftkenya.com

# OpenHIM API Domain (for backend services)
OPENHIM_API_DOMAIN=chanjo-client.intellisoftkenya.com

# SSL Certificate Configuration
