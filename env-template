# Keycloak Database  
KEYCLOAK_DB_USER=postgres
KEYCLOAK_DB_PASSWORD=keycloak_not_123
KEYCLOAK_DB_NAME=keycloak

# MongoDB (OpenHIM)
MONGO_INITDB_ROOT_USERNAME=admin
